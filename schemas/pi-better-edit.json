{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Rianico/pi-better-edit/schemas/pi-better-edit.json",
  "title": "pi-better-edit configuration",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "lens": {
      "type": "object",
      "properties": {
        "bridge": { "type": "string", "enum": ["auto", "on", "off"], "default": "auto" }
      },
      "additionalProperties": true
    },
    "store": {
      "type": "object",
      "description": "Storage housekeeping. The store DIRECTORY is not configurable here: PI_BETTER_EDIT_CONFIG_DIR owns it, so no file can move the store.",
      "properties": {
        "janitor": { "type": "string", "enum": ["on", "off"], "default": "on" },
        "janitorIntervalMs": { "type": "integer", "minimum": 1, "default": 86400000 },
        "janitorBatchSize": { "type": "integer", "minimum": 1, "default": 64 }
      },
      "additionalProperties": true
    },
    "bash": {
      "type": "object",
      "properties": {
        "view": { "type": "string", "enum": ["on", "off"], "default": "on" },
        "multiFile": {
          "type": "object",
          "description": "Multi-file bash view caps (ADR-0049 M6). Values outside the range are ignored with a warning and fall through the ladder.",
          "properties": {
            "maxFiles": { "type": "integer", "minimum": 2, "maximum": 10, "default": 10 },
            "maxRows": { "type": "integer", "minimum": 1, "maximum": 2000, "default": 2000 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
