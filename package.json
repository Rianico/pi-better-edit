{
  "name": "pi-hashline-edit-pro",
  "version": "0.18.2",
  "type": "module",
  "description": "Strict hashline read/replace tool for pi-coding-agent with hash-anchored edits (3-char, 18-bit, perfect hashing)",
  "main": "index.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuGiMob/pi-hashline-edit-pro.git"
  },
  "author": "pi-hashline-edit-pro contributors",
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "extension",
    "hashline",
    "hash-anchored",
    "strict"
  ],
  "license": "MIT",
  "files": [
    "index.ts",
    "src",
    "prompts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "diff": "^8.0.2",
    "file-type": "^21.3.0",
    "xxhash-wasm": "^1.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.74.0",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.ts' 'index.ts'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.7.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.8"
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "koffi@2.16.2": true,
    "protobufjs@7.6.4": true
  }
}
