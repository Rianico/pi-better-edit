// knip configuration — THE single source of config for this repo.
// (There is deliberately no "knip" key in package.json: knip resolves knip.json(c) first, so a
// package.json block would be dead config that silently drifts.)
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["index.ts", "scripts/**/*.{js,mjs,ts,mts}"],
  "project": ["src/**/*.ts", "scripts/**/*.{js,mjs,ts,mts}"],
  "ignore": [],
  // Strict: reports exports that nothing outside their own module imports. This is the setting that
  // caught the five dead exports fixed by hand in #78, so it is the one we keep.
  "ignoreExportsUsedInFile": false,
  // Both names are live public API (tests and the served-cap seam consume MAX_HASH_LINES, the
  // allocation path consumes USABLE_HASH_SPACE), so the alias cannot be dropped — but knip reports
  // every same-module alias pair as a duplicate export. Exemption is scoped to this one file and
  // this one issue type; duplicates elsewhere in the repo still fail the run.
  "ignoreIssues": {
    "src/hashline/hash-identity.ts": ["duplicates"],
  },
  "ignoreDependencies": [
    // knip DOES read .releaserc.json — its semantic-release plugin maps config.plugins
    // (node_modules/knip/dist/plugins/semantic-release/index.js:17). The reason npm and github are
    // still reported unused is an UPSTREAM PLUGIN POLICY: that plugin hard-codes an excludePackages
    // list of four names (:10-15) and filters exactly those out of dependency resolution (:18), so a
    // devDependency in that list can never be credited even when .releaserc.json lists it as a plugin.
    // Proof the file really is read: @semantic-release/git and ./scripts/release-changelog.mjs appear
    // ONLY in .releaserc.json, are absent from excludePackages, and are correctly NOT flagged.
    // Do NOT "fix" these findings by deleting release tooling: release.yml:42 runs
    // `pnpm exec semantic-release`, which loads exactly these plugins per .releaserc.json.
    "@semantic-release/npm", // .releaserc.json:6 — release plugin
    "@semantic-release/github", // .releaserc.json:7 — release plugin
    // Spawned as a binary, never imported. knip DOES ship a husky plugin
    // (node_modules/knip/dist/plugins/husky/index.js), but it credits husky only through the
    // package.json "hooks" shape or a husky invocation inside a .husky hook script. Ours is neither:
    // scripts/prepare.mjs:32 spawnSync()s the husky binary, and .husky/commit-msg merely sources
    // `_/husky.sh` (core.hooksPath=.husky/_), so nothing credits the devDependency.
    "husky",
  ],
  // The unused export/type surface was pruned to zero in this tranche, so the
  // count is 0 and NOTHING is tolerated: no finding is silenced or class-exempted,
  // and every finding is still counted as an error. The enforced baseline is the
  // --max-issues 0 cap on the CLI in package.json, which is a ratchet-only-down
  // tripwire: ANY new finding pushes the total above the cap and fails the run
  // mechanically (and is named in output). Keep `--max-issues 0` in both `lint`
  // and `lint:knip`: do NOT delete the flag — at 0 findings its failure semantics
  // equal bare knip, but it names the count and keeps the tripwire explicit.
  // knip's config schema has no maxIssues key, so the cap must live on the command line.
  //
  // Consequence, deliberate and documented: bare `knip` (no cap) exits 0 with empty
  // output on this repo as observed — it agrees with the capped run while the count
  // stays 0, which is exactly why the explicit cap stays: it names the count so a
  // future finding fails the enforced entry points, `pnpm run lint` and `pnpm run lint:knip`.
}
