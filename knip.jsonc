// knip configuration — THE single source of config for this repo.
// (There is deliberately no "knip" key in package.json: knip resolves knip.json(c) first, so a
// package.json block would be dead config that silently drifts.)
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["index.ts", "src/hashline/index.ts", "scripts/**/*.{js,mjs,ts,mts}"],
  "project": ["src/**/*.ts", "scripts/**/*.{js,mjs,ts,mts}"],
  "ignore": [],
  // Strict: reports exports that nothing outside their own module imports. This is the setting that
  // caught the five dead exports fixed by hand in #78, so it is the one we keep.
  "ignoreExportsUsedInFile": false,
  // Both names are live public API (tests and the served-cap seam consume MAX_HASH_LINES, the
  // allocation path consumes USABLE_HASH_SPACE), so the alias cannot be dropped — but knip reports
  // every same-module alias pair as a duplicate export. Exemption is scoped to this one file and
  // this one issue type; duplicates elsewhere in the repo still fail the run.
  "ignoreIssues": {
    "src/hashline/hash-identity.ts": ["duplicates"],
  },
  "ignoreDependencies": [
    // KNIP CANNOT SEE THROUGH .releaserc.json. Plugin names are strings in a JSON array, not
    // imports, so knip's dependency detection misses them entirely. Do NOT "fix" these findings by
    // deleting release tooling: release.yml runs `pnpm exec semantic-release`, which loads exactly
    // these plugins. Exempted only because they are genuinely used, knip-blind.
    "@semantic-release/npm", // .releaserc.json:6 — release plugin
    "@semantic-release/github", // .releaserc.json:7 — release plugin
    // Spawned as a binary, never imported: scripts/prepare.mjs:26 execs the `husky` binary, and
    // .husky/commit-msg sources `_/husky.sh` (core.hooksPath=.husky/_). Knip sees a devDependency
    // with no import and cannot follow the spawn.
    "husky",
  ],
  // The unused export/type surface is real and large (34 unused exports + 50 unused exported types)
  // and deliberately NOT pruned here: un-exporting dozens of symbols across ~23 modules is a
  // source-behaviour change that is out of scope for a toolchain ticket. The findings stay VISIBLE
  // in knip's output — nothing is silenced or class-exempted — and every one of them is still counted
  // as an error. The enforced baseline is the --max-issues cap on the CLI in package.json
  // (`knip --max-issues 84`), which is a ratchet: the 84 known findings are tolerated, but ANY new
  // finding pushes the total above the cap and fails the run mechanically (and is named in output).
  // knip's config schema has no maxIssues key, so the cap must live on the command line.
  //
  // LOWER the number as the debt is pruned; the follow-up pruning ticket should drive it to 0 and
  // then delete the flag entirely.
  //
  // Consequence, deliberate and documented: bare `knip` (no cap) exits 1 on this repo — it is not a
  // bug and must not be "fixed" by reintroducing a `rules` downgrade. The enforced entry points are
  // `pnpm run lint` and `pnpm run lint:knip`.
}
