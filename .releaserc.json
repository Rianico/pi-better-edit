{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    ["./scripts/release-changelog.mjs", { "changelogFile": "CHANGELOG.md" }],
    ["@semantic-release/npm", { "npmPublish": false }],
    "@semantic-release/github",
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "package.json",
          "pnpm-lock.yaml",
          ".config/changelog-unattributed-baseline.txt",
          ".config/basedpyright-baseline.txt"
        ],
        "message": "chore(release): ${nextRelease.version}\n\n${nextRelease.notes}"
      }
    ]
  ]
}
