#!/usr/bin/env bash
set -e
# skip in CI / when uv and python3 missing — semantic-release push must not fail on hook
if [ "${HUSKY:-}" = "0" ]; then exit 0; fi
if ! command -v uv >/dev/null 2>&1 && ! command -v python3 >/dev/null 2>&1; then exit 0; fi

# pre-push guard retired (ADR-0016): the `## [Unreleased]` ledger is curated, not a
# projection of commit subjects, so a stale block is no longer auto-amended here.
# The ledger is enforced by `.github/workflows/changelog-check.yml` via
# `scripts/changelog-gate.py` on every PR and on main. Do not reintroduce an
# auto-regeneration hook — it would overwrite curated entries.
exit 0